# SITE_URL: public URL of the site, without trailing slash (e.g. https://www.mon-domaine.fr).
# Used for canonical links, Open Graph tags and sitemap.xml. Strongly recommended in production.
SITE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used as a fallback when SITE_URL is not set.
APP_URL="MY_APP_URL"

# Firebase (statistics and contact requests). Firebase console > Project settings > Your apps > Web app.
# These keys are public by design: access is protected by firestore.rules.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# Storage bucket for the photos uploaded by professionals (Firebase > Storage), e.g. "mon-projet.firebasestorage.app".
VITE_FIREBASE_STORAGE_BUCKET=""

# Set to "true" to record statistics while running the dev server (off by default to keep figures clean).
VITE_TRACK_IN_DEV=""
