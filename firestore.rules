rules_version = '2';

// Visitors can add statistics, contact requests and listing requests, never read them.
// Professionals manage their own profile and listings, and read the statistics of their listings.
// L'Édition admins (accounts listed in the "admins" collection) can read and moderate everything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // An admin has an "admins/{uid}" document, or their confirmed e-mail address in "adminEmails"
    // (added from the "Équipe" tab of /admin, so they get access before even creating their account).
    function adminEntry() {
      return /databases/$(database)/documents/adminEmails/$(request.auth.token.email);
    }

    function invitedAdmin() {
      return signedIn() && request.auth.token.email_verified == true && exists(adminEntry());
    }

    function isAdmin() {
      return signedIn() && (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || invitedAdmin());
    }

    // Manages the team and the goals ("manage"); sees the goals and rewards ("goals").
    function isManager() {
      return invitedAdmin() && get(adminEntry()).data.manage == true;
    }

    function seesGoals() {
      return invitedAdmin() && (get(adminEntry()).data.goals == true || get(adminEntry()).data.manage == true);
    }

    // Adds and removes helpers ("team"): plain admins only, never goals or management rights.
    function managesTeam() {
      return invitedAdmin() && (get(adminEntry()).data.manage == true || get(adminEntry()).data.get('team', false) == true);
    }

    function plainMember(d) {
      return d.manage == false && d.goals == false && d.get('team', false) == false;
    }

    // Publishing requires a confirmed e-mail address (Google accounts are confirmed), to limit spam.
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    function optionalInt(value, max) {
      return value == null || (value is int && value >= 0 && value <= max);
    }

    // ---------- Anonymous statistics ----------
    // "visit" is a visit of the site (empty venue), the other types concern one listing.
    match /events/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'venue', 'session', 'path', 'referrer', 'owner', 'at'])
        && request.resource.data.type in ['visit', 'view', 'contact_open', 'lead', 'phone_click', 'website_click', 'portfolio_click', 'save']
        && shortString(request.resource.data.venue, 80)
        && shortString(request.resource.data.session, 40)
        && shortString(request.resource.data.path, 200)
        && shortString(request.resource.data.referrer, 120)
        && (!('owner' in request.resource.data) || shortString(request.resource.data.owner, 128))
        && request.resource.data.at == request.time;
      // A professional reads the statistics of their own listings (query: where owner == uid).
      allow read: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // ---------- Couples' contact requests (personal data: admins only) ----------
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasAll(['venue', 'firstName', 'email', 'consent', 'at'])
        && request.resource.data.keys().hasOnly(['venue', 'firstName', 'email', 'phone', 'weddingDate', 'guests', 'consent', 'at'])
        && shortString(request.resource.data.venue, 80)
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.email.size() <= 200
        && (!('phone' in request.resource.data) || shortString(request.resource.data.phone, 40))
        && (!('weddingDate' in request.resource.data) || shortString(request.resource.data.weddingDate, 10))
        && (!('guests' in request.resource.data)
            || (request.resource.data.guests is int && request.resource.data.guests > 0 && request.resource.data.guests <= 5000))
        && request.resource.data.consent == true
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------- Listing requests sent with the forms (venues and vendors) ----------
    match /submissions/{id} {
      allow create: if request.resource.data.keys().hasAll(['category', 'kind', 'name', 'commune', 'contactName', 'email', 'phone', 'consent', 'at'])
        && request.resource.data.keys().hasOnly(['category', 'kind', 'name', 'commune', 'zone', 'subtype', 'capacity', 'sleeps',
             'priceFrom', 'website', 'instagram', 'portfolio', 'contactName', 'role', 'email', 'phone', 'message', 'consent', 'at'])
        && request.resource.data.category is string
        && request.resource.data.category.matches('[a-z-]{2,40}')
        && request.resource.data.kind in ['nouveau', 'mise-a-jour']
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && shortString(request.resource.data.name, 120)
        && shortString(request.resource.data.commune, 80)
        && request.resource.data.contactName is string && request.resource.data.contactName.size() > 0
        && shortString(request.resource.data.contactName, 120)
        && request.resource.data.email is string
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.email.size() <= 200
        && shortString(request.resource.data.phone, 40)
        && (!('zone' in request.resource.data) || shortString(request.resource.data.zone, 60))
        && (!('subtype' in request.resource.data) || shortString(request.resource.data.subtype, 120))
        && (!('priceFrom' in request.resource.data) || shortString(request.resource.data.priceFrom, 120))
        && (!('website' in request.resource.data) || shortString(request.resource.data.website, 200))
        && (!('instagram' in request.resource.data) || shortString(request.resource.data.instagram, 120))
        && (!('portfolio' in request.resource.data) || shortString(request.resource.data.portfolio, 200))
        && (!('role' in request.resource.data) || shortString(request.resource.data.role, 60))
        && (!('message' in request.resource.data) || shortString(request.resource.data.message, 2000))
        && (!('capacity' in request.resource.data) || optionalInt(request.resource.data.capacity, 10000))
        && (!('sleeps' in request.resource.data) || optionalInt(request.resource.data.sleeps, 10000))
        && request.resource.data.consent == true
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------- Requests to have L'Édition create a portfolio (admins only) ----------
    match /portfolioRequests/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'company', 'category', 'email', 'phone', 'consent', 'at'])
        && request.resource.data.keys().hasOnly(['name', 'company', 'category', 'email', 'phone', 'current', 'message',
             'uid', 'listingId', 'consent', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && shortString(request.resource.data.name, 120)
        && request.resource.data.company is string && request.resource.data.company.size() > 0
        && shortString(request.resource.data.company, 120)
        && request.resource.data.category is string
        && request.resource.data.category.matches('([a-z-]{2,40})?')
        && request.resource.data.email is string
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.email.size() <= 200
        && shortString(request.resource.data.phone, 40)
        && (!('current' in request.resource.data) || shortString(request.resource.data.current, 200))
        && (!('message' in request.resource.data) || shortString(request.resource.data.message, 2000))
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid))
        && (!('listingId' in request.resource.data) || shortString(request.resource.data.listingId, 120))
        && request.resource.data.consent == true
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------- Professional profiles ----------
    function validProfile(d) {
      return d.keys().hasOnly(['firstName', 'lastName', 'phone', 'company', 'role', 'intents', 'photoURL', 'email',
             'termsAcceptedAt', 'createdAt', 'updatedAt'])
        && shortString(d.firstName, 80)
        && shortString(d.lastName, 80)
        && shortString(d.phone, 40)
        && shortString(d.company, 120)
        && shortString(d.role, 60)
        && d.intents is list && d.intents.size() <= 2
        && shortString(d.photoURL, 1000)
        && shortString(d.email, 200)
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ---------- Listings published by professionals ----------
    function validListing(id, d) {
      return d.keys().hasOnly(['ownerUid', 'type', 'category', 'slug', 'status', 'name', 'commune', 'zone', 'summary',
             'description', 'tags', 'highlight', 'phone', 'website', 'instagram', 'portfolio', 'photos', 'venueType', 'guestsMin',
             'guestsMax', 'sleeps', 'priceFrom', 'priceDetails', 'createdAt', 'updatedAt'])
        && d.type in ['lieu', 'prestataire']
        && d.category is string && d.category.matches('[a-z-]{2,40}')
        && (d.type == 'prestataire' || d.category == 'lieu')
        && d.slug is string && d.slug.matches('[a-z0-9-]{1,60}')
        && id == (d.type == 'lieu' ? d.slug : d.category + '.' + d.slug)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && shortString(d.commune, 80)
        && shortString(d.zone, 60)
        && shortString(d.summary, 200)
        && shortString(d.description, 4000)
        && d.tags is list && d.tags.size() <= 3
        && shortString(d.highlight, 300)
        && shortString(d.phone, 40)
        && shortString(d.website, 200)
        && shortString(d.instagram, 120)
        && (!('portfolio' in d) || shortString(d.portfolio, 200))
        && d.photos is list && d.photos.size() <= 8
        && shortString(d.venueType, 60)
        && optionalInt(d.guestsMin, 10000)
        && optionalInt(d.guestsMax, 10000)
        && d.sleeps is int && d.sleeps >= 0 && d.sleeps <= 10000
        && optionalInt(d.priceFrom, 10000000)
        && shortString(d.priceDetails, 200)
        && d.updatedAt == request.time;
    }

    function ownerCanSave(d) {
      return d.status in ['draft', 'published'] && (d.status == 'draft' || emailVerified());
    }

    match /listings/{id} {
      // Reading a missing document is allowed, so a new listing can check that its address is free.
      allow read: if resource == null
        || resource.data.status == 'published'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();

      // A professional creates a listing for themselves; curated venues ("reserved" slugs) can only be claimed.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && ownerCanSave(request.resource.data)
        && validListing(id, request.resource.data)
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/reserved/$(id));

      // The owner edits it, but cannot change its identity nor bring back a listing hidden by L'Édition.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && resource.data.status != 'hidden'
        && ownerCanSave(request.resource.data)
        && request.resource.data.type == resource.data.type
        && request.resource.data.category == resource.data.category
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && validListing(id, request.resource.data);

      // L'Édition moderates (hides, restores) and creates claimed listings for their owners.
      allow create, update: if isAdmin() && validListing(id, request.resource.data);
      allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
    }

    // Slugs of the curated venues: a professional can claim them, not take them.
    match /reserved/{slug} {
      allow read: if true;
    }

    // ---------- Claims of curated venues ----------
    match /claims/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'venueSlug', 'message', 'status', 'at'])
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.email, 200)
        && shortString(request.resource.data.name, 160)
        && request.resource.data.venueSlug is string && request.resource.data.venueSlug.matches('[a-z0-9-]{1,80}')
        && shortString(request.resource.data.message, 1000)
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Team of the dashboard, by e-mail address ----------
    match /adminEmails/{email} {
      allow read: if (signedIn() && request.auth.token.email == email) || managesTeam();
      allow create, update: if (isManager()
          || (managesTeam() && plainMember(request.resource.data) && (resource == null || plainMember(resource.data))))
        && email.matches('[^@ /A-Z]+@[^@ /A-Z]+[.][^@ /A-Z]+')
        && request.resource.data.keys().hasOnly(['manage', 'goals', 'team', 'addedBy', 'at'])
        && request.resource.data.manage is bool
        && request.resource.data.goals is bool
        && request.resource.data.get('team', false) is bool
        && shortString(request.resource.data.addedBy, 200)
        && request.resource.data.at == request.time;
      // Nobody removes their own access by mistake; helpers' managers only remove plain admins.
      allow delete: if email != request.auth.token.email && (isManager() || (managesTeam() && plainMember(resource.data)));
    }

    // ---------- Prospecting: venues and vendors to call and e-mail (admins only) ----------
    match /prospects/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'contact', 'kind', 'category', 'commune', 'phone', 'email',
             'website', 'status', 'notes', 'nextAction', 'calls', 'reached', 'emails', 'owner', 'venueSlug', 'history',
             'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && shortString(request.resource.data.name, 120)
        && request.resource.data.kind in ['lieu', 'prestataire']
        && request.resource.data.status in ['a_appeler', 'a_rappeler', 'mail_a_envoyer', 'mail_envoye', 'inscrit', 'refus']
        && shortString(request.resource.data.notes, 4000)
        && request.resource.data.history is list && request.resource.data.history.size() <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- Settings of the statistics (first day counted), read by admins and professionals ----------
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isManager()
        && request.resource.data.keys().hasOnly(['since', 'updatedBy', 'updatedAt'])
        && request.resource.data.since is string
        && request.resource.data.since.matches('([0-9]{4}-[0-9]{2}-[0-9]{2})?')
        && shortString(request.resource.data.updatedBy, 200)
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- Recruitment goals and rewards: the managers and the people with "goals" only ----------
    match /goals/{id} {
      allow read: if seesGoals();
      allow write: if isManager();
    }

    // ---------- Curated listings (written in the code) withdrawn from the site ----------
    // Read by every visitor (the site hides them) and by the build (no page is generated).
    match /removed/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'by', 'at'])
        && shortString(request.resource.data.name, 120)
        && shortString(request.resource.data.by, 200)
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }
  }
}
